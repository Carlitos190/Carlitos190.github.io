<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>F1 Live Timing</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #080808;
    --bg2: #0f0f0f;
    --bg3: #161616;
    --border: #222;
    --text: #d8d8d8;
    --dim: #555;
    --green: #39ff14;
    --purple: #cc00ff;
    --yellow: #ffe000;
    --red: #e8002d;
    --white: #ffffff;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Share Tech Mono', monospace;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ─── HEADER ─── */
  .header {
    background: linear-gradient(135deg, #1a0000 0%, #0a0a0a 60%);
    border-bottom: 2px solid var(--red);
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 4px 24px rgba(232,0,45,0.15);
  }

  .f1-wordmark {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .f1-logo {
    font-family: 'Orbitron', sans-serif;
    font-size: 26px;
    font-weight: 900;
    color: var(--red);
    letter-spacing: 4px;
    text-shadow: 0 0 20px rgba(232,0,45,0.5);
  }

  .f1-sub {
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    color: var(--dim);
    letter-spacing: 3px;
    margin-top: 2px;
  }

  .session-info {
    text-align: center;
    flex: 1;
    padding: 0 20px;
  }

  .session-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 3px;
  }

  .session-type-badge {
    display: inline-block;
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    font-weight: 600;
    color: #000;
    background: var(--red);
    padding: 2px 8px;
    border-radius: 2px;
    letter-spacing: 2px;
    margin-top: 4px;
  }

  .header-right {
    text-align: right;
    min-width: 130px;
  }

  .clock {
    font-family: 'Orbitron', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--green);
    letter-spacing: 2px;
    text-shadow: 0 0 12px rgba(57,255,20,0.4);
  }

  .live-indicator {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    margin-top: 3px;
  }

  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--green);
    animation: pulse 1.2s ease-in-out infinite;
  }

  .live-label {
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    color: var(--green);
    letter-spacing: 2px;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 6px rgba(57,255,20,0.8); }
    50% { opacity: 0.2; box-shadow: none; }
  }

  /* ─── INFO BAR ─── */
  .info-bar {
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 8px 20px;
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
    gap: 16px;
    overflow-x: auto;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 80px;
  }

  .info-label {
    font-family: 'Orbitron', sans-serif;
    font-size: 8px;
    color: var(--dim);
    letter-spacing: 1.5px;
  }

  .info-value {
    font-family: 'Orbitron', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--white);
  }

  /* ─── TIMING TABLE ─── */
  .timing-container {
    padding: 12px 8px;
    overflow-x: auto;
  }

  .timing-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 800px;
  }

  .timing-table thead tr {
    background: var(--bg3);
    border-bottom: 1px solid #252525;
  }

  .timing-table th {
    padding: 9px 10px;
    font-size: 9px;
    font-family: 'Orbitron', sans-serif;
    letter-spacing: 1.5px;
    color: var(--dim);
    text-align: center;
    font-weight: 400;
    white-space: nowrap;
    border-right: 1px solid #1a1a1a;
  }

  .timing-table th:last-child { border-right: none; }
  .th-driver { text-align: left !important; padding-left: 16px !important; }

  .timing-table tbody tr {
    border-bottom: 1px solid #151515;
    transition: background 0.25s;
  }

  .timing-table tbody tr:hover {
    background: rgba(255,255,255,0.025);
  }

  .timing-table td {
    padding: 10px 10px;
    text-align: center;
    font-size: 13px;
    white-space: nowrap;
    vertical-align: middle;
    border-right: 1px solid #141414;
  }

  .timing-table td:last-child { border-right: none; }

  /* Position */
  .td-pos {
    font-family: 'Orbitron', sans-serif;
    font-size: 15px;
    font-weight: 800;
    width: 40px;
  }

  .pos-1 { color: var(--yellow); text-shadow: 0 0 8px rgba(255,224,0,0.4); }
  .pos-2 { color: #c0c0c0; }
  .pos-3 { color: #cd8f3c; }

  /* Driver */
  .td-driver {
    text-align: left !important;
    padding-left: 14px !important;
  }

  .driver-inner {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .team-stripe {
    width: 3px;
    height: 22px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .driver-acronym {
    font-family: 'Orbitron', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 1.5px;
  }

  .driver-number {
    font-size: 10px;
    color: #444;
    font-family: 'Share Tech Mono', monospace;
  }

  .driver-team {
    font-size: 9px;
    color: #3a3a3a;
    font-family: 'Orbitron', sans-serif;
    letter-spacing: 0.5px;
    margin-left: 2px;
  }

  /* Times */
  .td-gap { color: #999; }
  .td-int { color: #777; font-size: 12px; }
  .td-lap { color: #d0d0d0; }

  .time-leader { color: #fff; font-weight: 600; }
  .time-purple { color: var(--purple) !important; text-shadow: 0 0 8px rgba(204,0,255,0.5); }
  .time-green  { color: var(--green) !important; text-shadow: 0 0 8px rgba(57,255,20,0.4); }
  .time-yellow { color: var(--yellow) !important; }

  /* Sectors */
  .td-sector {
    font-size: 11.5px;
    color: #666;
    font-family: 'Share Tech Mono', monospace;
  }

  /* Tire */
  .tire-wrap {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .tire-circle {
    width: 14px; height: 14px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 8px;
    font-weight: 700;
    font-family: 'Orbitron', sans-serif;
    flex-shrink: 0;
  }

  .tire-S { background: #e8002d; color: #fff; }
  .tire-M { background: #ffe000; color: #000; }
  .tire-H { background: #e8e8e8; color: #000; }
  .tire-I { background: #39ff14; color: #000; }
  .tire-W { background: #0088dd; color: #fff; }
  .tire-U { background: #555; color: #fff; }

  .tire-laps {
    font-size: 10px;
    color: var(--dim);
  }

  /* Pit */
  .pit-badge {
    background: #ff8c00;
    color: #000;
    font-family: 'Orbitron', sans-serif;
    font-size: 8px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 2px;
    letter-spacing: 1px;
    display: inline-block;
  }

  .pit-count {
    color: #555;
    font-size: 12px;
  }

  /* ─── STATES ─── */
  .loading-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    gap: 16px;
  }

  .loading-text {
    font-family: 'Orbitron', sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--green);
    animation: blink 1s step-end infinite;
  }

  .loading-sub {
    font-size: 11px;
    color: var(--dim);
    letter-spacing: 1px;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.15; }
  }

  .no-session-screen {
    text-align: center;
    padding: 70px 20px;
  }

  .no-session-screen h2 {
    font-family: 'Orbitron', sans-serif;
    font-size: 20px;
    color: var(--red);
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .no-session-screen p {
    color: var(--dim);
    font-size: 13px;
    margin: 6px 0;
  }

  .no-session-detail {
    margin-top: 24px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 16px 24px;
    display: inline-block;
    text-align: left;
    font-size: 12px;
    color: #666;
  }

  /* ─── LEGEND ─── */
  .legend {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 8px 12px;
    background: var(--bg2);
    border-top: 1px solid var(--border);
    font-size: 10px;
    color: var(--dim);
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .legend-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
  }

  /* ─── FOOTER ─── */
  .footer {
    text-align: center;
    padding: 10px;
    font-size: 10px;
    color: #2a2a2a;
    border-top: 1px solid #111;
  }

  /* ─── SCROLLBAR ─── */
  ::-webkit-scrollbar { width: 4px; height: 4px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: #2a2a2a; border-radius: 2px; }

  /* ─── GREEN FLAG / RACE TIMER ─── */
  .race-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
    gap: 12px;
  }

  /* PRE-LARGADA: botón llamativo */
  .flag-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 2px solid #1a4a0a;
    border-radius: 6px;
    padding: 10px 18px;
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'Orbitron', sans-serif;
    color: #39ff14;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    position: relative;
    overflow: hidden;
  }

  .flag-btn:hover, .flag-btn:active {
    background: rgba(57,255,20,0.08);
    border-color: var(--green);
    box-shadow: 0 0 18px rgba(57,255,20,0.25);
  }

  /* SVG bandera verde dentro del botón */
  .flag-icon {
    width: 22px; height: 22px;
    flex-shrink: 0;
  }

  .flag-btn-hint {
    font-size: 9px;
    color: #2a6a1a;
    letter-spacing: 1px;
    font-family: 'Share Tech Mono', monospace;
    font-weight: 400;
  }

  /* Pulso cuando está esperando */
  .flag-btn.waiting {
    animation: flag-pulse 2s ease-in-out infinite;
  }

  @keyframes flag-pulse {
    0%, 100% { border-color: #1a4a0a; box-shadow: none; }
    50% { border-color: var(--green); box-shadow: 0 0 16px rgba(57,255,20,0.3); }
  }

  /* POST-LARGADA: cronómetro activo */
  .race-timer-display {
    display: none;
    align-items: center;
    gap: 12px;
  }

  .race-timer-label {
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    color: var(--dim);
    letter-spacing: 2px;
  }

  .race-timer-value {
    font-family: 'Orbitron', sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--green);
    letter-spacing: 2px;
    text-shadow: 0 0 14px rgba(57,255,20,0.5);
    min-width: 120px;
  }

  .race-timer-prefix {
    font-size: 12px;
    color: #2a6a1a;
    margin-right: 2px;
  }

  /* Indicador de carrera en curso */
  .race-active-badge {
    display: none;
    align-items: center;
    gap: 6px;
    background: rgba(57,255,20,0.07);
    border: 1px solid rgba(57,255,20,0.2);
    border-radius: 4px;
    padding: 4px 10px;
  }

  .race-active-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--green);
    animation: pulse 0.8s ease-in-out infinite;
  }

  .race-active-text {
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    color: var(--green);
    letter-spacing: 2px;
  }

  /* Botón reset pequeño */
  .reset-btn {
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 5px 10px;
    cursor: pointer;
    font-family: 'Orbitron', sans-serif;
    font-size: 8px;
    color: #444;
    letter-spacing: 1px;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .reset-btn:hover { border-color: var(--red); color: var(--red); }

  /* Cuando carrera activa, cambiar borde del header a verde */
  body.race-on .header { border-bottom-color: var(--green); }
  body.race-on .f1-logo { color: var(--green); text-shadow: 0 0 20px rgba(57,255,20,0.4); }

  /* ─── TRACK STATUS BANNER ─── */
  .track-status {
    padding: 6px 20px;
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: 700;
    display: none;
    text-align: center;
  }

  .ts-green { background: #0a2a0a; color: var(--green); display: block; }
  .ts-yellow { background: #2a2000; color: var(--yellow); display: block; }
  .ts-red { background: #2a0008; color: var(--red); display: block; }
  .ts-sc { background: #2a1800; color: #ff8c00; display: block; }
  .ts-vsc { background: #1a1a00; color: #ffff00; display: block; }

  /* ─── BOTTOM PANELS ─── */
  .bottom-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 2px solid var(--border);
  }

  @media (max-width: 700px) {
    .bottom-panels { grid-template-columns: 1fr; }
  }

  .bp-panel {
    background: var(--bg);
    border-right: 1px solid var(--border);
  }

  .bp-panel:last-child { border-right: none; }

  .bp-header {
    background: var(--bg3);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 5;
  }

  .bp-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--text);
  }

  .bp-meta {
    font-family: 'Orbitron', sans-serif;
    font-size: 8px;
    color: var(--dim);
    letter-spacing: 1.5px;
  }

  .bp-body {
    padding: 0;
    max-height: 420px;
    overflow-y: auto;
  }

  /* Race Results */
  .result-row {
    display: flex;
    align-items: center;
    padding: 8px 14px;
    border-bottom: 1px solid #111;
    gap: 10px;
    transition: background 0.2s;
    border-left: 2px solid transparent;
  }

  .result-row:hover { background: rgba(255,255,255,0.025); }

  .result-pos {
    font-family: 'Orbitron', sans-serif;
    font-size: 15px;
    font-weight: 800;
    width: 30px;
    text-align: center;
    flex-shrink: 0;
  }

  .rpos-1 { color: var(--yellow); text-shadow: 0 0 8px rgba(255,224,0,0.4); }
  .rpos-2 { color: #c0c0c0; }
  .rpos-3 { color: #cd8f3c; }
  .rpos-n { color: #333; }

  .result-info { flex: 1; min-width: 0; }

  .result-acronym {
    font-family: 'Orbitron', sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 1.5px;
  }

  .result-num {
    font-size: 9px;
    color: #333;
    font-family: 'Share Tech Mono', monospace;
    margin-left: 4px;
  }

  .result-team {
    font-family: 'Orbitron', sans-serif;
    font-size: 8px;
    color: #2a2a2a;
    letter-spacing: 0.5px;
    margin-top: 2px;
  }

  .result-right {
    text-align: right;
    flex-shrink: 0;
  }

  .result-gap {
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px;
    color: #555;
  }

  .result-gap.leader { color: var(--green); font-size: 9px; letter-spacing: 1px; font-family: 'Orbitron', sans-serif; }

  .result-pts {
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    color: #333;
    margin-top: 2px;
  }

  /* Points per position F1 2026 */
  .pts-highlight { color: var(--yellow) !important; }

  /* Investigations */
  .invest-item {
    padding: 10px 14px;
    border-bottom: 1px solid #111;
    transition: background 0.2s;
  }

  .invest-item:hover { background: rgba(255,255,255,0.02); }

  .invest-top {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 5px;
    flex-wrap: wrap;
  }

  .invest-badge {
    font-family: 'Orbitron', sans-serif;
    font-size: 7px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 2px;
    letter-spacing: 1.5px;
    flex-shrink: 0;
  }

  .ib-invest   { background: #ff8c00; color: #000; }
  .ib-penalty  { background: var(--red); color: #fff; }
  .ib-cleared  { background: #0a200a; color: var(--green); border: 1px solid rgba(57,255,20,0.25); }
  .ib-warning  { background: #2a2000; color: var(--yellow); border: 1px solid rgba(255,224,0,0.2); }
  .ib-noted    { background: #111; color: #555; border: 1px solid #222; }

  .invest-lap-tag {
    font-family: 'Orbitron', sans-serif;
    font-size: 8px;
    color: #2a2a2a;
    letter-spacing: 1px;
    background: #111;
    padding: 1px 5px;
    border-radius: 2px;
  }

  .invest-driver-tag {
    font-family: 'Orbitron', sans-serif;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 1px 5px;
    border-radius: 2px;
  }

  .invest-msg {
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px;
    color: #777;
    line-height: 1.6;
    word-break: break-word;
  }

  .invest-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
  }

  .invest-time {
    font-size: 9px;
    color: #222;
    font-family: 'Share Tech Mono', monospace;
  }

  .invest-session-tag {
    font-family: 'Orbitron', sans-serif;
    font-size: 7px;
    color: #222;
    letter-spacing: 1px;
  }

  .bp-empty {
    text-align: center;
    padding: 40px 20px;
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
    color: #222;
    letter-spacing: 2px;
  }

  .invest-count-badge {
    background: var(--red);
    color: #fff;
    font-family: 'Orbitron', sans-serif;
    font-size: 8px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 10px;
    letter-spacing: 1px;
    animation: pulse 2s ease-in-out infinite;
  }

  .invest-count-ok {
    color: var(--green) !important;
  }

  /* ─── FIA DOCUMENTS DRAWER ─── */
  .fia-docs-btn {
    background: transparent;
    border: 1px solid #252525;
    color: #444;
    font-family: 'Orbitron', sans-serif;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 5px 11px;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .fia-docs-btn:hover { border-color: var(--red); color: var(--red); }
  .fia-docs-btn.active { border-color: var(--yellow); color: var(--yellow); background: rgba(255,224,0,0.04); }

  .fia-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 199;
    display: none;
    backdrop-filter: blur(3px);
  }
  .fia-overlay.visible { display: block; }

  .fia-drawer {
    position: fixed;
    top: 0; right: 0;
    width: min(520px, 100vw);
    height: 100vh;
    background: #090909;
    border-left: 1px solid #1c1c1c;
    z-index: 200;
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.4,0,0.2,1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: -12px 0 50px rgba(0,0,0,0.9);
